import { Button, VerticalBox, StandardTableView, SpinBox, TabWidget, LineEdit, ComboBox, Spinner, StandardButton, HorizontalBox, ProgressIndicator, Palette, StyleMetrics } from "std-widgets.slint";

export component DownloadTab inherits Rectangle {
    in-out property <string> url_in;
    property <string> destination;
    property <int> index;
    property <[string]> types: ["Видео", "Аудио"];
    in-out property <bool> is_working: false;
    in-out property <bool> is_success: false;
    in-out property <bool> is_error: false;
    in-out property <string> error_details: "";

    callback download(string,int);
    callback success();
    callback error(string);
    error(details) => {
        error_details = details;
        is_working = false;
        is_error = true;
    }
    success => {
        is_working = false;
        is_success = true;
    }
    VerticalBox {
        height: 300px;
        padding: 12px;
        
        
        Text {
            text: "Вставьте ссылку на файл";
            vertical-alignment: TextVerticalAlignment.bottom;
        }
        LineEdit {
            input-type: InputType.text;
            placeholder-text: "Ссылка на файл .m3u8";
            text: "";
            edited(text) => {url_in = text}
        }
        Text {
            text: "Выберите тип скачиваемого контента";
            vertical-alignment: TextVerticalAlignment.bottom;
        }
        ComboBox {
            model: types;
            current-index: index;
            selected(current-value) => {index = self.current-index;}
        }
        Button {
            text: "Скачать";
            enabled: !url_in.is-empty;
            clicked => {
                download(url_in,index);
                is_working = true;
                is_success = false;
                is_error = false;
            }
        }
        Image {
            visible: is_success;
            height: 35px;
            source: @image-url("images/success.svg");
            colorize: Palette.accent-background;
        }
        Spinner {
            visible: is_working;
            height: 35px;
            indeterminate: true;
        }
        Dialog {
            visible: is_error; 
            VerticalBox {
                Text {
                    font-weight: 800;
                    text: "Ошибка при скачивании";
                }
                Text {
                    text: error_details;
                }
            }
            StandardButton { kind: ok; clicked => {parent.hide()}}
        }
    }
}